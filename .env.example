# Optional. Free Pexels API key (pexels.com/api). When set, hoodie and sneaker photos come from Pexels first.
# The key is visible in the browser bundle, so use a free key only.
VITE_PEXELS_KEY=
# Optional. URL of your own server endpoint that rewrites the assistant's grounded answer with an LLM.
# It receives POST { message, grounding, tools } and must return { text }. Never put an LLM API key in the browser.
VITE_AI_ENDPOINT=
# Optional. Base path when the site is served from a sub path, e.g. /shovid/ on GitHub Pages.
VITE_BASE=/
